# The Grid deploy settings (npm run deploy).
#
# Copy this file to `.env` and fill in the real values. `.env` is gitignored and
# holds no AWS keys: those live in aws-vault.
#
#   npm run deploy:dry     # build, show what would change
#   npm run deploy         # build, upload, purge Cloudflare
#   npm run purge-cache    # just the Cloudflare purge

# --- AWS -------------------------------------------------------------------
# The aws-vault profile holding the key of playallday-deploy-games, the one
# deploy user every game shares (Terraform in the playallday repo, infra/iam.tf).
# The deploy re-runs itself under `aws-vault exec <profile>`, which hands it
# short-lived credentials. Nothing to set when AWS credentials are already in
# the environment (CI).
AWS_VAULT_PROFILE=playallday-deploy-games
AWS_REGION=us-east-2

# --- Where the build goes --------------------------------------------------
# The bucket name equals the hostname it's served from: the S3 website endpoint
# picks the bucket out of the Host header.
AWS_S3_BUCKET=playallday.games

# Must be this game's slug: the build's asset URLs start /grid/
# (src/site.ts), and the deploy refuses any other prefix. It only ever lists and
# deletes under this prefix, and stops on a folder that holds files without this
# game's marker, so it can never wipe another game.
AWS_S3_PREFIX=grid

# --- Cloudflare ------------------------------------------------------------
# Cloudflare is in front of the bucket (it's what gives the site HTTPS), so a
# deploy has to clear the edge cache or players keep the old build. Purging is
# by URL, so other sites on the zone keep theirs. Copy these three from another
# game's .env; without them the deploy still uploads and just skips the purge.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_BASE_URL=https://playallday.games
